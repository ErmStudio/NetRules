#!/bin/sh
PATH=/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin
case "$1" in
  start)
    if netstat -ltn 2>/dev/null | grep -q ":8090"; then
      echo "ui already running"
    else
      ( /opt/sbin/lighttpd -f /opt/etc/mihomo/lighttpd.conf >/dev/null 2>&1 & )
      sleep 1
      echo "ui started"
    fi
    ;;
  stop)
    pid=$(netstat -ltnp 2>/dev/null | grep ":8090 " | head -1 | awk '{print $NF}' | cut -d/ -f1)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    echo "ui stopped"
    ;;
  restart)
    $0 stop; sleep 1; $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    ;;
esac